@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix fcd:  <https://example.org/fincrime-data#> .

# MODULE 4a of the semantic layer: the source vocabulary (fcd:), the terms of our two tables: transaction, account, from/to account, timestamp,
# same-bank flag, customer type, risk rating, ... It records the limits of the data too (no raw amount, no country, tenure with no reference date).
# Specific to this database: it changes when the database changes. Which AML term each of these answers is module 4b
# (ontology/alignment/aml_data_alignment.ttl); which column holds it is module 5.
# Split on 2026-11-10 from mapping/data_layer.ttl (merged on the same day from tx_ontology.ttl and bridge.ttl).
# DRAFT by Claude. Not reviewed by the user or a domain expert. Namespace is a placeholder.
# Derived from demo/mapping/obda/transaction_ontology.ttl, reduced to what tx_features supports here.


<https://example.org/fincrime-data> a owl:Ontology ;
    rdfs:comment "Transactions and the accounts they move money between. Built from the IBM AML sample (synthetic); no raw amount, no country." .

fcd:Transaction a owl:Class ; rdfs:comment "One transfer from one account to another." .
fcd:Account     a owl:Class ; rdfs:comment "An account, identified by its id in the data." .

fcd:txId        a owl:DatatypeProperty ; rdfs:domain fcd:Transaction ; rdfs:range xsd:integer ;
    rdfs:comment "Identifier of the transaction in the data." .
fcd:timestamp   a owl:DatatypeProperty ; rdfs:domain fcd:Transaction ; rdfs:range xsd:dateTime ;
    rdfs:comment "When the transfer happened. Minute resolution; the data covers 1 to 18 September 2022." .
fcd:fromAccount a owl:ObjectProperty ; rdfs:domain fcd:Transaction ; rdfs:range fcd:Account ;
    rdfs:comment "The paying account." .
fcd:toAccount   a owl:ObjectProperty ; rdfs:domain fcd:Transaction ; rdfs:range fcd:Account ;
    rdfs:comment "The receiving account." .
fcd:amountLog   a owl:DatatypeProperty ; rdfs:domain fcd:Transaction ; rdfs:range xsd:double ;
    rdfs:comment "A logarithm of the amount (which log is not yet confirmed). The raw amount is not in the data." .
fcd:sameBank    a owl:DatatypeProperty ; rdfs:domain fcd:Transaction ; rdfs:range xsd:boolean ;
    rdfs:comment "True when the paying and the receiving account are at the same bank. False means between banks. Between banks is not the same as cross-border: the data has no country." .

# ---- Account context (synthetic KYC; context for the investigator, not evidence for any T0039 indicator)
fcd:customerType a owl:DatatypeProperty ; rdfs:domain fcd:Account ; rdfs:range xsd:string ;
    rdfs:comment "Individual or Company. Synthetic: generated by AML Triage, not part of the IBM data." .
fcd:industry a owl:DatatypeProperty ; rdfs:domain fcd:Account ; rdfs:range xsd:string ;
    rdfs:comment "Industry of a Company account; absent for individuals. Synthetic, assigned at random independent of the transactions." .
fcd:onboardingTenureDays a owl:DatatypeProperty ; rdfs:domain fcd:Account ; rdfs:range xsd:integer ;
    rdfs:comment "Days since the account was opened, 30 to 3650. Synthetic: a random draw with no reference date and no link to the transaction dates; do not compare it with transaction times." .
fcd:pepFlag a owl:DatatypeProperty ; rdfs:domain fcd:Account ; rdfs:range xsd:boolean ;
    rdfs:comment "Politically exposed person flag. Synthetic." .
fcd:riskRating a owl:DatatypeProperty ; rdfs:domain fcd:Account ; rdfs:range xsd:string ;
    rdfs:comment "Low, Medium or High. Synthetic: derived by AML Triage from the declared attributes, not from transactions." .
