@prefix rr:  <http://www.w3.org/ns/r2rml#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix fcd: <https://example.org/fincrime-data#> .
@prefix map: <https://example.org/obda/tx_features#> .
@prefix align: <https://example.org/align#> .
@prefix amx: <https://example.org/amltrix/> .

# DRAFT. R2RML mapping from table tx_features (AML Triage features.duckdb) to the terms of the source vocabulary (ontology/alignment/source_vocabulary.ttl).
# Table "tx" is a lens over tx_features that declares tx_id unique (mappings/lenses/tx_features.lens.json); run Ontop with -v mappings/lenses/tx_features.lens.json.
# Without the lens Ontop self-joins tx_features once per property.
# Self-transfers (from_account = to_account) are kept: they are in the data, and the loop rules deal with them.

# align:realisesSource says which data source of the typology a table provides (DRAFT, our reading): the transfers are the transaction logs and,
# only in part, the cross-border transaction data (just the same-bank flag); the profiles are KYC records. R2RML ignores the line; src/sources.py
# and src/typology.py read it.
map:TransactionMap a rr:TriplesMap ;
    align:realisesSource amx:DS0019 , amx:DS0047 ;
    rr:logicalTable [ rr:tableName "tx" ] ;
    rr:subjectMap [ rr:template "https://example.org/transaction/{tx_id}" ; rr:class fcd:Transaction ] ;
    rr:predicateObjectMap
        [ rr:predicate fcd:txId ;        rr:objectMap [ rr:column "tx_id" ; rr:datatype xsd:integer ] ] ,
        [ rr:predicate fcd:timestamp ;   rr:objectMap [ rr:column "ts" ; rr:datatype xsd:dateTime ] ] ,
        [ rr:predicate fcd:fromAccount ; rr:objectMap [ rr:template "https://example.org/account/{from_account}" ; rr:termType rr:IRI ] ] ,
        [ rr:predicate fcd:toAccount ;   rr:objectMap [ rr:template "https://example.org/account/{to_account}" ; rr:termType rr:IRI ] ] ,
        [ rr:predicate fcd:amountLog ;   rr:objectMap [ rr:column "amount_log" ; rr:datatype xsd:double ] ] ,
        [ rr:predicate fcd:sameBank ;    rr:objectMap [ rr:column "is_same_bank" ; rr:datatype xsd:boolean ] ] .

map:AccountFromMap a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "tx" ] ;
    rr:subjectMap [ rr:template "https://example.org/account/{from_account}" ; rr:class fcd:Account ] .

map:AccountToMap a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "tx" ] ;
    rr:subjectMap [ rr:template "https://example.org/account/{to_account}" ; rr:class fcd:Account ] .
