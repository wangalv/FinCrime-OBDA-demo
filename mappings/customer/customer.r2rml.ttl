@prefix rr:  <http://www.w3.org/ns/r2rml#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix fcd: <https://example.org/fincrime-data#> .
@prefix map: <https://example.org/obda/tx_features#> .
@prefix align: <https://example.org/align#> .
@prefix amx: <https://example.org/amltrix/> .

# MODULE 5 of the semantic layer (with tx_features.r2rml.ttl and tx_features.lens.json): the R2RML mapping of the customer profiles.
# Split on 2026-11-10 from mappings/transaction/tx_features.r2rml.ttl. The triples map keeps its IRI (map:AccountKycMap) so the realisesSource fact is unchanged.
# DRAFT. align:realisesSource says which data source of the typology the table provides (our reading): the profiles are KYC records.
# R2RML ignores the line; src/sources.py and src/typology.py read it.

# Account context from the synthetic kyc_profiles (generated by AML Triage, NOT IBM data). One row per account.
# Table "kyc" is a lens over kyc_profiles (mappings/lenses/tx_features.lens.json, the same lens file as the transfers): it declares account_id unique and turns the empty
# industry of individuals into NULL, so no industry triple is made for them.
map:AccountKycMap a rr:TriplesMap ;
    align:realisesSource amx:DS0039 ;
    rr:logicalTable [ rr:tableName "kyc" ] ;
    rr:subjectMap [ rr:template "https://example.org/account/{account_id}" ; rr:class fcd:Account ] ;
    rr:predicateObjectMap
        [ rr:predicate fcd:customerType ;          rr:objectMap [ rr:column "customer_type" ] ] ,
        [ rr:predicate fcd:industry ;              rr:objectMap [ rr:column "industry_or_null" ] ] ,
        [ rr:predicate fcd:onboardingTenureDays ;  rr:objectMap [ rr:column "onboarding_tenure_days" ; rr:datatype xsd:integer ] ] ,
        [ rr:predicate fcd:pepFlag ;               rr:objectMap [ rr:column "pep_flag" ; rr:datatype xsd:boolean ] ] ,
        [ rr:predicate fcd:riskRating ;            rr:objectMap [ rr:column "risk_rating" ] ] .
