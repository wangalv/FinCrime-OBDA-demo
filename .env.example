# Copy this file to `.env` in the repository root and fill it in. `.env` is git-ignored; never commit a real key.
#
# The demo calls any LLM that has an OpenAI-compatible chat API: the request goes to <LLM_BASE_URL>/chat/completions.

# The key from your provider. Leave empty for a server that needs none.
LLM_API_KEY=

# The API root of your provider, for example:
#   OpenAI        https://api.openai.com/v1
#   OpenRouter    https://openrouter.ai/api/v1
#   Z.ai (GLM)    https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=

# The model name your provider uses.
LLM_MODEL=

# Optional. A JSON object merged into every request, for a provider-specific switch, for example to turn thinking off:
# LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}

# Optional. Set to "off" if your provider rejects the response_format field (the call is retried without it anyway).
# LLM_JSON_MODE=off
